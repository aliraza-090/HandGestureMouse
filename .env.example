# HandGestureMouse Offline Configuration
APP_ENV=production
OFFLINE_MODE=True
AUTO_CHECK_UPDATES=False
TELEMETRY_ENABLED=False

# Model & Resource Paths
MODEL_PATH=src/handgesturemouse/resources/models/hand_landmarker.task
CONFIG_DIR=%APPDATA%/HandGestureMouse

# Default Runtime Safety
FAILSAFE_ENABLED=True
EMERGENCY_HOTKEY=ctrl+alt+e
